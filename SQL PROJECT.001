{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMO8MsptF+V04NkjnZFO5qO"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","metadata":{"id":"8157911d"},"source":["## Resources"]},{"cell_type":"markdown","metadata":{"id":"fa51b0a2"},"source":["### Question 1: Find the Nth highest salary\n","\n","Write a SQL query to find the Nth highest salary from an `Employees` table. For example, find the 2nd highest salary."]},{"cell_type":"code","metadata":{"id":"3d67d155"},"source":["```sql\n","-- Create a sample Employees table\n","CREATE TABLE Employees (\n","    id INT PRIMARY KEY,\n","    name VARCHAR(50),\n","    salary DECIMAL(10, 2)\n",");\n","\n","-- Insert sample data\n","INSERT INTO Employees (id, name, salary) VALUES\n","(1, 'Alice', 60000.00),\n","(2, 'Bob', 80000.00),\n","(3, 'Charlie', 75000.00),\n","(4, 'David', 90000.00),\n","(5, 'Eve', 75000.00);\n","\n","-- Solution for Nth highest salary (e.g., N=2)\n","SELECT salary\n","FROM Employees\n","ORDER BY salary DESC\n","LIMIT 1 OFFSET 1; -- For 2nd highest, OFFSET is N-1 = 1\n","\n","-- General solution using DENSE_RANK()\n","-- N can be changed in the WHERE clause\n","WITH RankedSalaries AS (\n","    SELECT\n","        salary,\n","        DENSE_RANK() OVER (ORDER BY salary DESC) as rnk\n","    FROM Employees\n",")\n","SELECT salary\n","FROM RankedSalaries\n","WHERE rnk = 2;"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"0abf9aad"},"source":["### Question 2: Find employees who earn more than their manager\n","\n","Given an `Employee` table with `id`, `name`, `salary`, and ``manager_id` fields, write a SQL query to find employees who earn more than their managers."]},{"cell_type":"code","metadata":{"id":"33cd4758"},"source":["```sql\n","-- Create a sample Employee table\n","CREATE TABLE Employee (\n","    id INT PRIMARY KEY,\n","    name VARCHAR(50),\n","    salary DECIMAL(10, 2),\n","    manager_id INT\n",");\n","\n","-- Insert sample data\n","INSERT INTO Employee (id, name, salary, manager_id) VALUES\n","(1, 'Joe', 70000, 3),\n","(2, 'Henry', 80000, 4),\n","(3, 'Sam', 60000, NULL),\n","(4, 'Max', 90000, NULL);\n","\n","-- Solution\n","SELECT E1.name AS Employee\n","FROM Employee E1\n","JOIN Employee E2 ON E1.manager_id = E2.id\n","WHERE E1.salary > E2.salary;"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"d0415b4f"},"source":["### Question 3: Find duplicate records\n","\n","Write a SQL query to find all duplicate rows in a table `Orders` based on `customer_id` and `order_date`."]},{"cell_type":"code","metadata":{"id":"9f4f11c3"},"source":["```sql\n","-- Create a sample Orders table\n","CREATE TABLE Orders (\n","    order_id INT PRIMARY KEY,\n","    customer_id INT,\n","    order_date DATE,\n","    amount DECIMAL(10, 2)\n",");\n","\n","-- Insert sample data\n","INSERT INTO Orders (order_id, customer_id, order_date, amount) VALUES\n","(1, 101, '2023-01-01', 150.00),\n","(2, 102, '2023-01-01', 200.00),\n","(3, 101, '2023-01-01', 150.00), -- Duplicate\n","(4, 103, '2023-01-02', 100.00),\n","(5, 102, '2023-01-01', 200.00); -- Duplicate\n","\n","-- Solution to find duplicate records\n","SELECT customer_id, order_date, COUNT(*) as duplicate_count\n","FROM Orders\n","GROUP BY customer_id, order_date\n","HAVING COUNT(*) > 1;\n","\n","-- To retrieve the full duplicate rows (if all columns define uniqueness)\n","SELECT *\n","FROM Orders\n","WHERE (customer_id, order_date) IN (\n","    SELECT customer_id, order_date\n","    FROM Orders\n","    GROUP BY customer_id, order_date\n","    HAVING COUNT(*) > 1\n",");\n","\n","-- Alternative using ROW_NUMBER() to identify and potentially delete duplicates\n","WITH DuplicateCTE AS (\n","    SELECT\n","        order_id,\n","        customer_id,\n","        order_date,\n","        ROW_NUMBER() OVER (PARTITION BY customer_id, order_date ORDER BY order_id) as rn\n","    FROM Orders\n",")\n","SELECT order_id, customer_id, order_date\n","FROM DuplicateCTE\n","WHERE rn > 1;"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"2a5ec30d"},"source":["### Question 4: Calculate running total\n","\n","Write a SQL query to calculate the running total of `sales` for each `day` in a `Sales` table."]},{"cell_type":"code","metadata":{"id":"5c7500cf"},"source":["```sql\n","-- Create a sample Sales table\n","CREATE TABLE Sales (\n","    sale_id INT PRIMARY KEY,\n","    sale_date DATE,\n","    amount DECIMAL(10, 2)\n",");\n","\n","-- Insert sample data\n","INSERT INTO Sales (sale_id, sale_date, amount) VALUES\n","(1, '2023-01-01', 100.00),\n","(2, '2023-01-01', 50.00),\n","(3, '2023-01-02', 200.00),\n","(4, '2023-01-03', 75.00),\n","(5, '2023-01-03', 125.00);\n","\n","-- Solution for running total\n","SELECT\n","    sale_date,\n","    amount,\n","    SUM(amount) OVER (ORDER BY sale_date) as running_total\n","FROM Sales\n","ORDER BY sale_date;"],"execution_count":null,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"001e2349"},"source":["### Question 5: Find the highest-spending customer per month\n","\n","Given a `Transactions` table with `transaction_id`, `customer_id`, `transaction_date`, and `amount`, write a SQL query to find the customer who spent the most in each month."]},{"cell_type":"code","metadata":{"id":"997b597b"},"source":["```sql\n","-- Create a sample Transactions table\n","CREATE TABLE Transactions (\n","    transaction_id INT PRIMARY KEY,\n","    customer_id INT,\n","    transaction_date DATE,\n","    amount DECIMAL(10, 2)\n",");\n","\n","-- Insert sample data\n","INSERT INTO Transactions (transaction_id, customer_id, transaction_date, amount) VALUES\n","(1, 101, '2023-01-05', 100.00),\n","(2, 102, '2023-01-10', 150.00),\n","(3, 101, '2023-01-15', 50.00),\n","(4, 103, '2023-01-20', 200.00),\n","(5, 101, '2023-02-01', 300.00),\n","(6, 102, '2023-02-05', 100.00),\n","(7, 103, '2023-02-10', 250.00),\n","(8, 104, '2023-02-15', 350.00);\n","\n","-- Solution\n","WITH MonthlySpending AS (\n","    SELECT\n","        STRFTIME('%Y-%m', transaction_date) AS month,\n","        customer_id,\n","        SUM(amount) AS total_spent\n","    FROM Transactions\n","    GROUP BY 1, 2\n","),\n","RankedMonthlySpending AS (\n","    SELECT\n","        month,\n","        customer_id,\n","        total_spent,\n","        RANK() OVER (PARTITION BY month ORDER BY total_spent DESC) as rnk\n","    FROM MonthlySpending\n",")\n","SELECT\n","    month,\n","    customer_id,\n","    total_spent\n","FROM RankedMonthlySpending\n","WHERE rnk = 1\n","ORDER BY month;"],"execution_count":null,"outputs":[]}]}